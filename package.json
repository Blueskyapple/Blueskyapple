    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "inquirer": "^9.2.23",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^4.52.0",
    "uuid": "^10.0.0",
    "ws": "^8.17.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.9",
