# === BlueBot Configuration ===

# LLM Provider: "anthropic" or "openai"
BLUEBOT_LLM_PROVIDER=anthropic

# API Keys (set the one matching your provider)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Model to use (optional, defaults are sensible)
# BLUEBOT_MODEL=claude-sonnet-4-20250514
# BLUEBOT_MODEL=gpt-4o

# === Messaging Adapters (enable the ones you want) ===

# CLI adapter is always enabled.

# Discord
# DISCORD_BOT_TOKEN=your-discord-bot-token

# Telegram
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# === Memory ===
# Directory for persistent memory (default: ~/.bluebot/memory)
# BLUEBOT_MEMORY_DIR=~/.bluebot/memory

# === Skills ===
# Enable shell command execution (default: false for safety)
BLUEBOT_ENABLE_SHELL=false

# === Gateway ===
# Log level: DEBUG, INFO, WARNING, ERROR
BLUEBOT_LOG_LEVEL=INFO
